// RexFoot — schéma Prisma
//
// Principe de conception : chaque entité synchronisée depuis un fournisseur de
// données football (ex. API-Football) porte un `provider` + `externalId` en plus
// de son `id` interne (cuid). Toutes les relations internes pointent sur `id`,
// jamais sur `externalId` — ça garantit qu'on peut changer de fournisseur plus
// tard (ou en avoir plusieurs) sans casser le schéma ni les données existantes.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CompetitionType {
  LEAGUE
  CUP
  INTERNATIONAL
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
  POSTPONED
  CANCELLED
}

enum FixtureEventType {
  GOAL
  OWN_GOAL
  PENALTY
  MISSED_PENALTY
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  VAR
}

enum MatchVoteChoice {
  HOME
  DRAW
  AWAY
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsCategory {
  TRANSFERTS
  RESULTATS
  ANALYSES
  INTERVIEWS
  COMPETITIONS
  INTERNATIONAL
  AUTRE
}

/// Ordre déclaratif significatif : orderBy(desc) sur ce type place URGENT
/// avant HIGH (Postgres trie les enums selon l'ordre de déclaration).
enum BreakingPriority {
  HIGH
  URGENT
}

enum TrendingEntityType {
  ARTICLE
  VIDEO
  TEAM
  PLAYER
  TALENT_PROFILE
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum VideoModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum VideoLicenseType {
  ORIGINAL
  LICENSED
  FAIR_USE
}

enum VideoCommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum VideoReportReason {
  SPAM
  COPYRIGHT
  ABUSE
  OTHER
}

enum VideoReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

/// ADMIN = "Super Admin" dans l'UI — la valeur d'enum reste ADMIN pour ne pas
/// invalider le compte admin existant (voir packages/db/prisma/create-admin.ts).
enum UserRole {
  USER
  JOURNALIST
  EDITOR
  MODERATOR
  ANALYST
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum FavoriteEntityType {
  TEAM
  PLAYER
  COMPETITION
}

// ---------------------------------------------------------------------------
// Football — compétitions, saisons, équipes, joueurs
// ---------------------------------------------------------------------------

model Competition {
  id          String          @id @default(cuid())
  provider    String
  externalId  String
  name        String
  slug        String          @unique
  type        CompetitionType @default(LEAGUE)
  logoUrl     String?
  countryName String?
  countryCode String?
  /// Ordre d'affichage (plus petit = plus mis en avant).
  tier        Int             @default(100)
  isActive    Boolean         @default(true)

  seasons                Season[]
  teamCompetitionSeasons TeamCompetitionSeason[]
  fixtures               Fixture[]
  standings              Standing[]
  news                   NewsArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([isActive, tier])
}

model Season {
  id         String    @id @default(cuid())
  provider   String
  externalId String
  year       String
  startDate  DateTime?
  endDate    DateTime?
  isCurrent  Boolean   @default(false)

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  teamCompetitionSeasons TeamCompetitionSeason[]
  playerTeamMemberships  PlayerTeamMembership[]
  fixtures               Fixture[]
  standings              Standing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([competitionId, isCurrent])
}

model Team {
  id          String  @id @default(cuid())
  provider    String
  externalId  String
  name        String
  shortName   String?
  slug        String  @unique
  crestUrl    String?
  foundedYear Int?
  venueName   String?
  venueCity   String?
  countryCode String?

  competitionSeasons TeamCompetitionSeason[]
  playerMemberships  PlayerTeamMembership[]
  homeFixtures       Fixture[]               @relation("HomeTeam")
  awayFixtures       Fixture[]               @relation("AwayTeam")
  standings          Standing[]
  teamStatistics     TeamStatistics[]
  playerStatistics   PlayerStatistics[]
  lineups            Lineup[]
  relatedNews        NewsArticle[]
  relatedVideos      Video[]
  fixtureEvents      FixtureEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
}

model Player {
  id          String          @id @default(cuid())
  provider    String
  externalId  String
  firstName   String
  lastName    String
  displayName String
  slug        String          @unique
  photoUrl    String?
  dateOfBirth DateTime?
  nationality String?
  position    PlayerPosition?
  heightCm    Int?
  weightKg    Int?

  /// Correction manuelle de `nationality`, jamais touchée par upsertPlayer (voir
  /// apps/worker/src/lib/upsert.ts) — écrasée sinon à chaque resync (6h) par la
  /// valeur du fournisseur, qui accuse parfois des mois de retard sur un
  /// changement de sélection nationale récent (ex. Ayyoub Bouaddi, Issa Diop :
  /// passés à la nationalité sportive marocaine avant la Coupe du monde 2026,
  /// football-data.org indiquait toujours "France" en septembre 2026). Tout le
  /// code qui lit la nationalité d'un joueur doit préférer ce champ à `nationality`.
  nationalityOverride String?

  teamMemberships PlayerTeamMembership[]
  statistics      PlayerStatistics[]
  fixtureEvents   FixtureEvent[]         @relation("EventPlayer")
  assistEvents    FixtureEvent[]         @relation("EventAssistPlayer")
  relatedEvents   FixtureEvent[]         @relation("EventRelatedPlayer")
  relatedNews     NewsArticle[]
  relatedVideos   Video[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
}

/// Un joueur peut changer d'équipe d'une saison à l'autre — cette table
/// capture l'appartenance équipe/saison plutôt qu'une relation directe fixe.
model PlayerTeamMembership {
  id          String    @id @default(cuid())
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonId    String
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  shirtNumber Int?
  joinedAt    DateTime?
  leftAt      DateTime?

  @@unique([playerId, teamId, seasonId])
  @@index([teamId, seasonId])
}

/// Quelles équipes jouent dans quelle compétition/saison (nécessaire pour
/// scoper les classements et gérer les phases de groupes).
model TeamCompetitionSeason {
  id            String      @id @default(cuid())
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  seasonId      String
  season        Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  groupName     String?

  @@unique([teamId, competitionId, seasonId])
}

// ---------------------------------------------------------------------------
// Football — matchs
// ---------------------------------------------------------------------------

model Fixture {
  id         String        @id @default(cuid())
  provider   String
  externalId String
  round      String?
  kickoffAt  DateTime
  status     FixtureStatus @default(SCHEDULED)
  /// Minute de jeu courante, uniquement pertinent quand status = LIVE/HALFTIME.
  minute     Int?
  homeScore  Int?
  awayScore  Int?
  venueName  String?
  referee    String?

  /// Horodatage de la revérification post-match du score final auprès du
  /// fournisseur — null tant qu'elle n'a pas eu lieu. Nécessaire car le
  /// score qu'on capture au moment où un match passe FINISHED n'est pas
  /// toujours définitif : football-data.org peut corriger un score après
  /// coup (constaté en prod : un match affiché 1-1 chez nous est resté
  /// figé alors que le fournisseur avait corrigé en 1-0 plus d'une heure
  /// après la fin — notre sync ne revérifie jamais un match déjà FINISHED).
  /// Voir finalizeRecentMatches() dans syncLiveScores.ts.
  finalScoreConfirmedAt  DateTime?
  /// Même principe que finalScoreConfirmedAt, mais pour les événements
  /// (buts/cartons) : un but refusé par la VAR après coup (ex. Carlos Espí,
  /// Betis-Real Madrid du 04/09/2026) reste enregistré comme un vrai but tant
  /// que ce champ est null — voir finalizeRecentMatchEvents() dans
  /// syncMatchEvents.ts. Champ séparé de finalScoreConfirmedAt car un job
  /// différent (Highlightly, pas football-data.org) s'en charge.
  finalEventsConfirmedAt DateTime?

  /// Id du même match côté Highlightly (Sport Highlights API) — résolu une
  /// fois par recherche nom d'équipe + date (voir apps/worker/src/jobs/
  /// syncMatchEvents.ts), puis mis en cache ici pour ne plus jamais refaire
  /// cette recherche : le quota gratuit (100 requêtes/jour) ne le permettrait pas.
  highlightlyId                Int?      @unique
  /// Dernière tentative (réussie ou non) de résolution de highlightlyId —
  /// null tant qu'aucune tentative n'a eu lieu. Bug réel constaté en prod
  /// (2026-09-05, journée à 11 matchs en direct simultanés) : sans ce champ,
  /// syncMatchEvents.ts retentait la recherche paginée (jusqu'à 3 requêtes)
  /// à CHAQUE cycle (10 min) pour tout match encore non résolu — le quota
  /// gratuit (100/jour) a été entièrement consommé en un peu plus d'une
  /// heure, bloquant même les matchs déjà résolus (plus aucun but/minute mis
  /// à jour pour personne). Sert de garde-fou pour espacer les tentatives.
  highlightlyLookupAttemptedAt DateTime?

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  seasonId      String
  season        Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeTeamId    String
  homeTeam      Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId    String
  awayTeam      Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])

  events           FixtureEvent[]
  teamStatistics   TeamStatistics[]
  playerStatistics PlayerStatistics[]
  lineups          Lineup[]
  relatedVideos    Video[]
  votes            MatchVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([competitionId, seasonId, round])
  @@index([status, kickoffAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model FixtureEvent {
  id              String           @id @default(cuid())
  fixtureId       String
  fixture         Fixture          @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  type            FixtureEventType
  minute          Int
  extraMinute     Int?
  teamId          String
  team            Team             @relation(fields: [teamId], references: [id])
  playerId        String?
  player          Player?          @relation("EventPlayer", fields: [playerId], references: [id])
  assistPlayerId  String?
  assistPlayer    Player?          @relation("EventAssistPlayer", fields: [assistPlayerId], references: [id])
  relatedPlayerId String?
  relatedPlayer   Player?          @relation("EventRelatedPlayer", fields: [relatedPlayerId], references: [id])
  // Nom brut (jamais résolu vers Player, voir syncMatchEvents.ts) : buteur/joueur
  // sanctionné pour la plupart des types, joueur ENTRANT pour une SUBSTITUTION.
  detail          String?
  // Joueur SORTANT pour une SUBSTITUTION uniquement (`detail` = joueur entrant) ;
  // toujours null pour les autres types d'événement.
  detailOut       String?

  @@index([fixtureId, minute])
}

model Standing {
  id               String      @id @default(cuid())
  competitionId    String
  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  seasonId         String
  season           Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId           String
  team             Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  groupName        String?
  position         Int
  /// Position au sync précédent (avant d'écraser `position` ci-dessus) — permet
  /// d'afficher une flèche montée/descente sans historique complet. Null tant
  /// qu'un seul sync a eu lieu (pas encore de "avant" à comparer).
  previousPosition Int?
  played           Int         @default(0)
  won              Int         @default(0)
  drawn            Int         @default(0)
  lost             Int         @default(0)
  goalsFor         Int         @default(0)
  goalsAgainst     Int         @default(0)
  goalDifference   Int         @default(0)
  points           Int         @default(0)
  /// Forme récente, ex. "WWDLW" (du plus ancien au plus récent).
  form             String?

  updatedAt DateTime @updatedAt

  @@unique([competitionId, seasonId, teamId, groupName])
  @@index([competitionId, seasonId, position])
}

model TeamStatistics {
  id                String  @id @default(cuid())
  fixtureId         String
  fixture           Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamId            String
  team              Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  possession        Int?
  shotsTotal        Int?
  shotsOnTarget     Int?
  corners           Int?
  fouls             Int?
  offsides          Int?
  yellowCards       Int?
  redCards          Int?
  /// "Occasions" — la statistique la plus proche de ce qu'affichent les sites
  /// comme Marca à côté du direct. Absente du plan gratuit football-data.org,
  /// disponible via Highlightly (voir apps/worker/src/jobs/syncMatchEvents.ts).
  expectedGoals     Float?
  bigChancesCreated Int?

  @@unique([fixtureId, teamId])
}

/// Composition d'une équipe pour un match — joueurs stockés en JSON (nom,
/// numéro, poste), jamais liés à notre table Player : aucune correspondance
/// d'id fiable entre Highlightly et notre fournisseur principal (même choix
/// que FixtureEvent.detail, voir syncMatchEvents.ts).
model Lineup {
  id          String   @id @default(cuid())
  fixtureId   String
  fixture     Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  formation   String?
  startingXI  Json
  substitutes Json
  updatedAt   DateTime @updatedAt

  @@unique([fixtureId, teamId])
}

model PlayerStatistics {
  id            String  @id @default(cuid())
  fixtureId     String
  fixture       Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  minutesPlayed Int?
  goals         Int?
  assists       Int?
  shots         Int?
  shotsOnTarget Int?
  passes        Int?
  passAccuracy  Int?
  tackles       Int?
  rating        Float?
  yellowCards   Int?
  redCards      Int?

  @@unique([fixtureId, playerId])
  @@index([playerId])
}

/// Vote "qui va gagner ?" affiché sur le hero d'un match — anonyme (dédupliqué
/// par cookie voterKey, voir lib/voter.ts), jamais lié à un compte utilisateur
/// puisque RexFoot n'a pas encore de comptes publics.
model MatchVote {
  id        String          @id @default(cuid())
  fixtureId String
  fixture   Fixture         @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  voterKey  String
  choice    MatchVoteChoice
  createdAt DateTime        @default(now())

  @@unique([fixtureId, voterKey])
  @@index([fixtureId])
}

/// Log d'affichage anonyme pour calculer les tendances (section 19 du plan) —
/// jamais de classement inventé : uniquement des vues réelles, comptées sur
/// une fenêtre glissante côté requête (voir lib/data/trending.ts), et
/// dédupliquées par visiteur côté API pour qu'un simple rafraîchissement de
/// page ne fausse pas le classement.
model PageView {
  id         String             @id @default(cuid())
  entityType TrendingEntityType
  entityId   String
  createdAt  DateTime           @default(now())

  @@index([entityType, createdAt])
}

// ---------------------------------------------------------------------------
// Mercato
// ---------------------------------------------------------------------------

enum TransferStatus {
  OFFICIEL
  AVANCE
  EN_DISCUSSION
  RUMEUR
}

/// Transfert au format "ticker mercato" — volontairement en texte libre pour
/// le joueur et les clubs (playerName/fromClubName/toClubName) plutôt que des
/// FK vers Player/Team : une rumeur de mercato concerne souvent un joueur ou
/// un club qui n'existe pas encore dans les données synchronisées par
/// apps/worker. Pas de statut "officiel" par défaut — voir @default(RUMEUR) :
/// ne jamais présenter par erreur une rumeur comme confirmée (section 13 du plan).
model Transfer {
  id            String         @id @default(cuid())
  playerName    String
  fromClubName  String?
  toClubName    String?
  status        TransferStatus @default(RUMEUR)
  feeMillionEur Float?
  isFree        Boolean        @default(false)
  transferDate  DateTime?
  sourceName    String?
  sourceUrl     String?
  notes         String?
  authorId      String?
  author        User?          @relation(fields: [authorId], references: [id])
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

// ---------------------------------------------------------------------------
// Actualités
// ---------------------------------------------------------------------------

model NewsArticle {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  summary       String?
  contentHtml   String
  coverImageUrl String?
  category      NewsCategory @default(AUTRE)
  authorId      String?
  author        User?        @relation(fields: [authorId], references: [id])
  sourceUrl     String?
  status        NewsStatus   @default(DRAFT)
  publishedAt   DateTime?

  /// Section 12 du plan : jamais permanent — voir getActiveBreakingNews(), qui
  /// ne considère un article "breaking" que dans les BREAKING_NEWS_WINDOW_HOURS
  /// suivant breakingSince (pas publishedAt : marquer un vieil article comme
  /// urgent doit le rendre actif immédiatement, pas selon sa date d'origine).
  isBreaking       Boolean          @default(false)
  breakingPriority BreakingPriority @default(HIGH)
  breakingSince    DateTime?

  relatedCompetitionId String?
  relatedCompetition   Competition? @relation(fields: [relatedCompetitionId], references: [id])
  relatedTeamId        String?
  relatedTeam          Team?        @relation(fields: [relatedTeamId], references: [id])
  relatedPlayerId      String?
  relatedPlayer        Player?      @relation(fields: [relatedPlayerId], references: [id])

  /// Agent éditorial autonome (apps/worker/src/jobs/editorial) : brouillon
  /// jamais publié automatiquement — voir isAiDraft pour le badge de revue
  /// admin, sources pour les liens consultés, suggestedVideoUrl pour un clip
  /// officiel proposé et suggestedCoverImageUrl pour une image glanée dans le
  /// flux RSS source (jamais auto-intégrés) que l'admin peut reprendre à la main.
  isAiDraft              Boolean         @default(false)
  suggestedVideoUrl      String?
  suggestedCoverImageUrl String?
  sources                ArticleSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([isBreaking, breakingSince])
}

/// Sources RSS consultées par l'agent éditorial pour un article donné —
/// affichées en lecture seule dans l'admin pour que la relecture humaine
/// puisse vérifier ce qui a été utilisé (jamais le corps des articles sources,
/// seulement titre + lien : voir EDITORIAL_SOURCE_FEEDS).
model ArticleSource {
  id            String      @id @default(cuid())
  articleId     String
  article       NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url           String
  title         String
  publisherName String
  retrievedAt   DateTime    @default(now())
}

/// Mémoire anti-doublon de l'agent éditorial : un sujet déjà rédigé (même lors
/// d'un run précédent) n'est jamais rédigé une deuxième fois. `topicKey` est un
/// titre normalisé (minuscules, sans accents) — comparaison volontairement simple.
model CoveredTopic {
  id          String   @id @default(cuid())
  topicKey    String   @unique
  articleId   String?
  sourceUrls  String[]
  firstSeenAt DateTime @default(now())
}

/// Fichier binaire uploadé depuis le panel admin (ex. image de couverture d'un
/// article) et stocké directement en base — évite de dépendre d'un stockage
/// objet externe (S3/R2) tant que le volume d'images reste modeste. Servi via
/// GET /api/assets/[id].
model Asset {
  id        String   @id @default(cuid())
  mimeType  String
  filename  String
  byteSize  Int
  data      Bytes
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Vidéo — fonctionnalité de première classe (voir packages/video-provider)
// ---------------------------------------------------------------------------

model Video {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  uploaderId  String?
  uploader    User?   @relation(fields: [uploaderId], references: [id])

  providerName    String
  providerAssetId String?
  playbackUrl     String?
  thumbnailUrl    String?
  durationSeconds Int?

  status           VideoStatus           @default(UPLOADING)
  moderationStatus VideoModerationStatus @default(PENDING)
  licenseType      VideoLicenseType      @default(ORIGINAL)
  rightsHolder     String?

  publishedAt DateTime?
  viewCount   Int       @default(0)
  likeCount   Int       @default(0)

  relatedFixtureId String?
  relatedFixture   Fixture? @relation(fields: [relatedFixtureId], references: [id])
  relatedTeamId    String?
  relatedTeam      Team?    @relation(fields: [relatedTeamId], references: [id])
  relatedPlayerId  String?
  relatedPlayer    Player?  @relation(fields: [relatedPlayerId], references: [id])

  tags          VideoTagAssignment[]
  views         VideoView[]
  likes         VideoLike[]
  favorites     VideoFavorite[]
  comments      VideoComment[]
  reports       VideoReport[]
  /// Relation inverse de TalentProfile.videoId (un talent a au plus une vidéo).
  talentProfile TalentProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([moderationStatus, status, publishedAt])
}

model VideoTag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  videos VideoTagAssignment[]
}

model VideoTagAssignment {
  id         String   @id @default(cuid())
  videoId    String
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoTagId String
  videoTag   VideoTag @relation(fields: [videoTagId], references: [id], onDelete: Cascade)

  @@unique([videoId, videoTagId])
}

model VideoView {
  id             String   @id @default(cuid())
  videoId        String
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  viewedAt       DateTime @default(now())
  watchedSeconds Int?

  @@index([videoId, viewedAt])
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
}

model VideoFavorite {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
}

model VideoComment {
  id              String             @id @default(cuid())
  videoId         String
  video           Video              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentCommentId String?
  parentComment   VideoComment?      @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         VideoComment[]     @relation("CommentReplies")
  body            String
  status          VideoCommentStatus @default(VISIBLE)
  createdAt       DateTime           @default(now())

  @@index([videoId, createdAt])
}

model VideoReport {
  id           String            @id @default(cuid())
  videoId      String
  video        Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reportedById String
  reportedBy   User              @relation("VideoReportsFiled", fields: [reportedById], references: [id])
  reason       VideoReportReason
  details      String?
  status       VideoReportStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  reviewedById String?
  reviewedBy   User?             @relation("VideoReportsReviewed", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  @@index([videoId, status])
}

// ---------------------------------------------------------------------------
// RexFoot Talents — profils de joueurs auto-soumis, découverte par des
// recruteurs. Toujours modéré manuellement (jamais publié automatiquement),
// voir TalentModerationStatus. Distinct de Player (synchronisé depuis un
// fournisseur externe via provider/externalId, historique club/stats) : un
// TalentProfile est saisi par le joueur lui-même, sans lien avec les données
// scoutées.
// ---------------------------------------------------------------------------

/// Plus fin que PlayerPosition (GOALKEEPER/DEFENDER/MIDFIELDER/FORWARD) —
/// section 6 du plan demande un poste précis (ex. distinguer un latéral droit
/// d'un latéral gauche). Prévu extensible (commentaire du plan) : un nouveau
/// poste s'ajoute par migration, sans casser les valeurs existantes.
enum TalentPosition {
  GOALKEEPER
  CENTRE_BACK
  RIGHT_BACK
  LEFT_BACK
  DEFENSIVE_MIDFIELDER
  CENTRE_MIDFIELDER
  ATTACKING_MIDFIELDER
  RIGHT_WINGER
  LEFT_WINGER
  STRIKER
}

enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}

enum TalentSituation {
  FREE_AGENT
  IN_CLUB
  SEEKING_CLUB
  CONTRACT_ENDING
}

/// PENDING à la soumission, jamais publié automatiquement (section 12 du
/// plan) — HIDDEN distinct de REJECTED : un profil déjà approuvé qu'on
/// retire temporairement (ex. demande du joueur) sans le refuser formellement.
enum TalentModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model TalentProfile {
  id             String   @id @default(cuid())
  slug           String   @unique
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  nationality    String
  currentCountry String
  city           String?

  position          TalentPosition
  secondaryPosition TalentPosition?
  preferredFoot     PreferredFoot?
  heightCm          Int?

  situation   TalentSituation
  currentClub String?

  /// Codes ISO2 — voir apps/web/src/lib/talents/target-countries.ts. Tableau
  /// natif Postgres plutôt qu'une table de jointure : section 8 du plan
  /// ("pas de système compliqué"), une poignée de pays par joueur au plus.
  targetCountries  String[]
  openToAnyCountry Boolean  @default(false)

  photoUrl String?
  videoId  String? @unique
  video    Video?  @relation(fields: [videoId], references: [id])
  about    String?

  /// Consentement explicite avant publication (section 23 du plan).
  consentGiven       Boolean   @default(false)
  consentGivenAt     DateTime?
  /// Calculé à partir de dateOfBirth au moment de la soumission et figé ici
  /// (section 22) : l'âge change, mais le statut "mineur au moment de l'envoi"
  /// ne doit pas — sert de trace pour le consentement parental exigé alors.
  isMinor            Boolean   @default(false)
  parentConsentGiven Boolean   @default(false)

  /// Numéro collecté pour l'envoi WhatsApp initial — jamais affiché
  /// publiquement à moins que contactConsentGiven soit vrai (section 21).
  whatsappNumber      String
  contactConsentGiven Boolean @default(false)

  status        TalentModerationStatus @default(PENDING)
  moderatedAt   DateTime?
  moderatedById String?
  moderatedBy   User?                  @relation(fields: [moderatedById], references: [id])

  /// Compteur simple, jamais dédupliqué (section 27 : "pas besoin d'un
  /// système complexe") — contrairement aux vues de profil/vidéo, qui
  /// réutilisent PageView (TrendingEntityType.TALENT_PROFILE) et
  /// Video.viewCount, déjà dédupliqués par visiteur.
  contactClickCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Utilisateurs, favoris, modération
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  displayName   String
  avatarUrl     String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  /// Opt-in explicite : la page /u/[id] renvoie 404 tant que ce n'est pas activé depuis /account.
  publicProfile Boolean    @default(false)

  articles                NewsArticle[]
  transfers               Transfer[]
  videos                  Video[]
  videoViews              VideoView[]
  videoLikes              VideoLike[]
  videoFavorites          VideoFavorite[]
  videoComments           VideoComment[]
  videoReportsFiled       VideoReport[]   @relation("VideoReportsFiled")
  videoReportsReviewed    VideoReport[]   @relation("VideoReportsReviewed")
  favorites               Favorite[]
  blocksInitiated         UserBlock[]     @relation("BlockInitiator")
  blocksReceived          UserBlock[]     @relation("BlockTarget")
  auditLogEntries         AuditLog[]
  notifications           Notification[]
  moderatedTalentProfiles TalentProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Favori générique — équipe, joueur ou compétition suivie par un utilisateur.
model Favorite {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType FavoriteEntityType
  entityId   String
  createdAt  DateTime           @default(now())

  @@unique([userId, entityType, entityId])
}

/// Seul déclencheur réel pour l'instant : la publication d'une alerte "breaking"
/// (voir notifyBreakingNews dans lib/data/notifications-admin.ts côté web) — pas
/// de notif liée aux favoris, relatedTeamId/relatedPlayerId sur NewsArticle
/// n'étant renseignés nulle part dans le panel admin.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  linkUrl   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockInitiator", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

/// Trace d'audit des actions de modération (qui a fait quoi, sur quoi).
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id])
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
}

/// Ligne unique (id fixe "singleton") pilotant le lecteur audio YouTube Live
/// affiché sur les pages match. Pas de détection automatique via l'API YouTube
/// Data v3 pour l'instant (demande explicite de Hicham, 2026-09-07 : toggle
/// manuel en attendant) — isLive est basculé à la main depuis /admin/live-audio.
model LiveAudioStream {
  id        String   @id @default("singleton")
  isLive    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
