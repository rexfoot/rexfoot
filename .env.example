# Copie ce fichier en `.env` (racine) et remplis les valeurs.
# `.env` est ignoré par git — ne jamais committer de vraies valeurs.
# En production (Railway), ces variables sont définies dans les Settings > Variables
# de chaque service, jamais dans le repo.

# --- Base de données ---
# Fournie par le plugin PostgreSQL de Railway (onglet "Connect" > "Postgres Connection URL").
DATABASE_URL="postgresql://user:password@host:5432/rexfoot"

# --- Cache / jobs ---
# Fournie par le plugin Redis de Railway (onglet "Connect" > "Redis Connection URL").
REDIS_URL="redis://default:password@host:6379"

# --- Fournisseur de données football ---
# football-data.org est préféré s'il est configuré (gratuit, sans carte
# bancaire, 10 requêtes/minute, pas de plafond quotidien) — inscription sur
# https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_API_KEY=""
# API-Football reste en repli si sa clé est présente (utile si un compte
# football-data.org n'est pas configuré, ou en secours).
# https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=""
RAPIDAPI_HOST="v3.football.api-sports.io"

# --- Vidéo ---
# "stub" tant que Cloudflare Stream n'est pas configuré (aucun upload possible,
# erreur explicite dans le panel admin). "cloudflare-stream" une fois les deux
# variables ci-dessous renseignées.
VIDEO_PROVIDER="stub"
# Dashboard Cloudflare > Stream > Overview (Account ID, colonne de droite).
CLOUDFLARE_ACCOUNT_ID=""
# Dashboard Cloudflare > Manage Account > API Tokens > Create Token, avec la
# permission "Stream: Edit" pour ce compte.
CLOUDFLARE_STREAM_API_TOKEN=""

# --- RexFoot AI (résumés, traductions…) ---
# Tous optionnels et essayés dans cet ordre (Gemini -> Groq -> OpenRouter) ;
# laisser vide = fonctionnalités IA désactivées (erreur explicite, jamais de
# contenu inventé). Les trois ont un plan gratuit sans carte bancaire.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# https://console.groq.com/keys
GROQ_API_KEY=""
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# --- App ---
# NODE_ENV n'est pas défini ici volontairement : Next.js (dev/build/start), tsx et
# Docker le fixent eux-mêmes selon le contexte. Le définir manuellement dans .env
# entre en conflit avec la valeur que `next build` impose (bug Next.js 16.x connu :
# https://github.com/vercel/next.js/issues/86178 — crash au prerendering de /_global-error).
LOG_LEVEL="info"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# URL du studio vidéo — application SÉPARÉE (repo rexfoot-video-studio), jamais
# déployée avec ce repo, aucune clé API ici. Utilisée uniquement par le lien
# "🎬 Générer une vidéo" de l'admin (apps/web/src/app/(admin)/admin/(protected)/news/page.tsx)
# pour ouvrir le studio avec l'article déjà sélectionné.
NEXT_PUBLIC_VIDEO_STUDIO_URL="http://localhost:3100"

# --- Rate limiting ---
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_SECONDS="60"

# --- Publication automatique Facebook (Graph API) ---
# Page Access Token longue durée (pages_show_list, pages_read_engagement,
# pages_manage_posts) généré depuis Meta Business Suite pour la page RexFoot.
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""

# --- Photos de joueurs (TheSportsDB) ---
# Optionnel : laissé vide, le worker utilise la clé "test" publique ("3"),
# partagée avec tout Internet et donc régulièrement en 429 (quota dépassé),
# cause connue du taux élevé de photos manquantes. Une clé Patreon
# (thesportsdb.com/api.php) ici lève cette limite, sans autre changement.
THESPORTSDB_API_KEY=""
