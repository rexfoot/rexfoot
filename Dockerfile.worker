# RexFoot — apps/worker (process Node autonome, jobs BullMQ)
#
# apps/worker importe les packages partagés (@rexfoot/config, @rexfoot/db,
# @rexfoot/football-provider) directement depuis leur source TypeScript
# (package.json "main": "src/index.ts", aucune étape de build/dist pour ces
# packages). Ça fonctionne pour apps/web parce que `next build` transpile et
# bundle tout dans .next/ une fois pour toutes. apps/worker n'a pas de tel
# bundler : on exécute donc son point d'entrée avec `tsx` (déjà utilisé en
# dev) plutôt que de compiler en JS puis lancer `node dist/index.js`, qui ne
# peut pas résoudre les imports TypeScript des packages partagés au runtime.
# `tsc --noEmit` reste lancé pendant le build pour garder un vrai garde-fou
# de types avant de déployer.

FROM node:22-slim AS base
WORKDIR /app
# Le moteur de requête Prisma a besoin de libssl pour détecter la version
# openssl du système — sans ça il retombe sur une valeur par défaut avec un
# warning au démarrage (inoffensif mais évitable).
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/ai-provider/package.json packages/ai-provider/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/football-provider/package.json packages/football-provider/package.json
COPY packages/video-provider/package.json packages/video-provider/package.json
RUN npm ci

FROM deps AS build
COPY . .
RUN npm run prisma:generate
RUN npm run typecheck:worker

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/tsconfig.base.json ./tsconfig.base.json
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/worker ./apps/worker

WORKDIR /app/apps/worker
# Voir Dockerfile (apps/web) pour le détail : `migrate deploy` est idempotent
# et sûr en concurrence, donc les deux services peuvent l'exécuter au démarrage
# sans risque de course, même s'ils démarrent en même temps sur Railway.
CMD ["sh", "-c", "npx prisma migrate deploy --schema=/app/packages/db/prisma/schema.prisma && npm run start"]
